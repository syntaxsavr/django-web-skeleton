# django-web-skeleton environment template
# Copy to .env and fill in. Every variable is optional in DEBUG mode.
# In production (DJANGO_DEBUG=False) SECRET_KEY becomes mandatory.

# --- Core switch: True = development, False = production ---
# DEBUG=False automatically enables HSTS, SSL redirect, secure cookies,
# SECURE_PROXY_SSL_HEADER and requires DJANGO_SECRET_KEY to be set.
DJANGO_DEBUG=True

# --- Required in production ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# --- Optional overrides (fall back to the admin control panel) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CONTACT_RECIPIENT_EMAIL=office@example.com

# --- Email (production) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=web@example.com

# --- Bootstrap seed (manage.py seed) ---
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=b_4sIcPW007
# SEED_ADMIN_EMAIL=admin@example.com

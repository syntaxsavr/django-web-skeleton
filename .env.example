# django-skeleton-eu-ready environment template
# Copy this file to .env. The application loads it without an extra package.
# Keep .env private: Git ignores it, and it may contain production secrets.

# Core switch: True = development, False = production.
# DEBUG=False automatically enables HSTS, SSL redirect, secure cookies,
# SECURE_PROXY_SSL_HEADER and requires DJANGO_SECRET_KEY to be set.
DJANGO_DEBUG=True

# Required in production. Generate a long, unique secret for each deployment.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional security and contact overrides.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RECIPIENT_EMAIL=

# Production email. Debug mode prints email to the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Bootstrap account used by `python manage.py seed`.
# Replace the password before running the command on a shared system.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
